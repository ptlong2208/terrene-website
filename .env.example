# Google Analytics
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Sanity CMS
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-07-30

# Haravan — products and orders
HARAVAN_API_TOKEN=

# Brevo — transactional email and newsletter
BREVO_API_KEY=
BREVO_LIST_ID=

# Brevo — payment webhook failure alert (lib/alert.ts)
ALERT_TO_EMAIL=          # owner's email, receives the alert
ALERT_FROM_EMAIL=        # verified Brevo sender, e.g. noreply@your-domain.com

# Site URL — no trailing slash, production only (preview falls back to VERCEL_URL)
SITE_URL=https://your-domain.com

# PayOS — payment gateway
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=

# Vercel KV (Upstash Redis) — pending order store between checkout and webhook
KV_REST_API_URL=
KV_REST_API_TOKEN=

# GHTK — shipping fee calculation (nationwide standard + Sài Gòn-cũ express, see lib/ghtk.ts)
GHTK_API_TOKEN=
GHTK_SHOP_ID=
SHIPPING_FALLBACK_FEE=15000
SHIPPING_MAX_ORDER_WEIGHT=3000

# Supabase — product reviews (Postgres + Storage), anon/publishable key only, RLS enforces access
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# OpenAI — free Moderation API, pre-screens review text/photos before Storage upload
OPENAI_API_KEY=
